# JARVIS environment - copy to .env and fill in. NEVER commit .env.
# Placeholders only. Run `jarvis check-config` to validate (it never prints secrets).

JARVIS_ENV=development

# --- Telegram (Phase 1) ---------------------------------------------------
# Create a bot with @BotFather -> /newbot, paste the token here.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (message @userinfobot to get it). Comma-separate for more.
TELEGRAM_ALLOWED_USER_IDS=

# --- Security -------------------------------------------------------------
# Generate with: python -m jarvis gen-secret
JARVIS_SECRET_KEY=
# Password for the web dashboard (min 12 chars).
JARVIS_DASHBOARD_PASSWORD=
JARVIS_DASHBOARD_HOST=127.0.0.1
JARVIS_DASHBOARD_PORT=8000

# --- Database -------------------------------------------------------------
# Default: SQLite at ./data/jarvis.db. PostgreSQL later, e.g.
# postgresql+psycopg://jarvis:<password>@localhost/jarvis
JARVIS_DATABASE_URL=
JARVIS_BACKUP_DIR=

# --- Schedule (optional; briefings only run when all three are set) ------
# IANA timezone, e.g. America/New_York
JARVIS_TIMEZONE=
# 24h HH:MM local time
JARVIS_BRIEFING_TIME=
JARVIS_EVENING_REVIEW_TIME=

# --- Lead workflow ----------------------------------------------------------
JARVIS_FOLLOWUP_HOURS=24
# Keep false. Auto-replies are not implemented; v1 is draft-only.
JARVIS_AUTO_REPLY_ENABLED=false
JARVIS_RATE_LIMIT_PER_MINUTE=20
JARVIS_LOG_LEVEL=INFO
JARVIS_BUSINESS_PROFILE=

# --- Krypt Trader link (read-only) ----------------------------------------
# Leave empty to auto-detect (%APPDATA%\Krypt Trader\data\krypt-trader.db on Windows).
# JARVIS opens this file read-only: it can never place trades or change Krypt settings.
KRYPT_TRADER_DB=
# Telegram alerts when a Krypt position wins, loses or errors.
JARVIS_KRYPT_ALERTS=true
# Folder holding Krypt's backtest.py (default: ../python in this repo).
KRYPT_TRADER_SRC=

# --- Email (Phase 3, not implemented yet) ----------------------------------
# Paths to Google OAuth client secrets + stored token. Never put an email password here.
GMAIL_CLIENT_SECRETS_FILE=
GMAIL_TOKEN_FILE=
